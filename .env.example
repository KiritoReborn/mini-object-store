# Global Configuration Defaults
CHUNK_SIZE=1000000
REPLICATION_FACTOR=2
HEARTBEAT_INTERVAL=5
WORKER_DEAD_TIMEOUT=15
RECONCILE_INTERVAL=5
CONTROLLER_PORT=8000
# Worker port is fixed at 8001 in config and Dockerfile.worker.

# Controller Specific Configuration
DATABASE_PATH=/data/metadata.db

# Worker Specific Configuration
WORKER_STORAGE_PATH=/data/chunks
WORKER_ID=worker1
CONTROLLER_URL=http://controller:8000

# Optional owner demo. Configure-Demo.ps1 generates the private key locally.
# ARTAUD_API_KEY=<at-least-32-random-characters>
# ARTAUD_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Enable worker container controls with Start-Artaud.ps1 -DemoControls.

